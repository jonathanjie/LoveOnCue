# Copy to .env.production at repository root; never commit that file.
# Hex-only DB password avoids URI percent-encoding surprises; generate at least 32 random bytes.
POSTGRES_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
DOMAIN=wedding.example.invalid
WEDDINGOPS_WEDDING_ID=replace-with-unique-cell-id
WEDDINGOPS_MODE=production
WEDDINGOPS_PUBLIC_URL=https://wedding.example.invalid
WEDDINGOPS_AGENT_MODE=deterministic
WEDDINGOPS_OPENCLAW_URL=http://127.0.0.1:18789
WEDDINGOPS_OPENCLAW_AGENT=weddingops-intent
WEDDINGOPS_OPENCLAW_TOKEN=
WEDDINGOPS_TELEGRAM_BOT_TOKEN=
WEDDINGOPS_TELEGRAM_WEBHOOK_SECRET=
WEDDINGOPS_TELEGRAM_BOT_USERNAME=
WEDDINGOPS_SEND_NOTIFICATIONS=false
# OpenClaw loopback above only works on the same host/network namespace.
# For containers, provision a PRIVATE isolated endpoint; never publish the Gateway port.
