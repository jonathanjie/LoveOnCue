{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "web/dist",
    "rootDir": "web/src",
    "skipLibCheck": true
  },
  "include": [
    "web/src/**/*.ts"
  ]
}
