# Copy to .env and load it in your shell; no real credentials are in this file.
WEDDINGOPS_MODE=demo
WEDDINGOPS_DATABASE_URL=sqlite:///.data/weddingops.db
WEDDINGOPS_WEDDING_ID=demo-wedding
WEDDINGOPS_PUBLIC_URL=http://127.0.0.1:8000
WEDDINGOPS_AGENT_MODE=deterministic
# Server default is 127.0.0.1; keep the demonstration local.
WEDDINGOPS_HOST=127.0.0.1
WEDDINGOPS_PORT=8000

# Optional Mistral API key. Deterministic mode makes no model calls.
WEDDINGOPS_MISTRAL_MODEL=deepseek-v4-1-flash-1017
WEDDINGOPS_MISTRAL_API_KEY=

# Optional Telegram: obtain separate development/production bots from BotFather.
WEDDINGOPS_TELEGRAM_BOT_TOKEN=
WEDDINGOPS_TELEGRAM_WEBHOOK_SECRET=
WEDDINGOPS_TELEGRAM_BOT_USERNAME=
WEDDINGOPS_SEND_NOTIFICATIONS=false

# Production example (requires the postgres extra):
# WEDDINGOPS_MODE=production
# WEDDINGOPS_DATABASE_URL=postgresql+psycopg://weddingops:REPLACE@db:5432/weddingops
# WEDDINGOPS_PUBLIC_URL=https://your-event.example
